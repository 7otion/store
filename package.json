{
	"name": "@7otion/store",
	"version": "0.1.0",
	"author": "Burak Kartal",
	"description": "A simple, highly opinionated store management library for React.",
	"repository": {
		"type": "git",
		"url": "https://github.com/7otion/store"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"store",
		"react",
		"state management",
		"signals",
		"reactive"
	],
	"license": "MIT",
	"sideEffects": false,
	"scripts": {
		"build": "bun build.mjs",
		"watch": "tsc --watch --preserveWatchOutput",
		"typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"format": "bunx prettier --write '**/*.{js,jsx,ts,tsx,json,css}' --ignore-path .prettierignore"
	},
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.14.3",
		"@testing-library/react": "^16.3.0",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"esbuild": "^0.27.3",
		"happy-dom": "^20.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"react": "^18 || ^19"
	}
}
