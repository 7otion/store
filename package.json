{
	"name": "@7otion/store",
	"version": "0.0.1",
	"author": "Burak Kartal",
	"description": "A simple, highly opinionated store management library for React.",
	"repository": {
		"type": "git",
		"url": "https://github.com/7otion/store"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"store",
		"react",
		"state management"
	],
	"license": "MIT",
	"scripts": {
		"build": "rm -rf dist && tsc --emitDeclarationOnly && node build.mjs",
		"watch": "tsc --watch --preserveWatchOutput",
		"format": "bunx prettier --write '**/*.{js,jsx,ts,tsx,json,css}' --ignore-path .prettierignore"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"devDependencies": {
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"esbuild": "^0.27.3",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
}
